{% extends 'base.html.twig' %}

{% block title %}Club index
{% endblock %}

{% block body %}
	<div class="container-fluid">
		<div class="row">
			{% include "DashNavbar.html.twig" %}
			<main class="col-12 col-md-9 col-lg-10 p-4">
				<div class="d-flex justify-content-between align-items-center mb-4">
					<h1>Clubs Management</h1>
					<div class="d-flex gap-3 align-items-center">
						<form method="get" action="{{ path('app_club_index') }}" class="input-group" style="width: 300px;">
							<input type="text" name="search" class="form-control" placeholder="Search clubs..." value="{{ app.request.get('search') }}">
							<button class="btn btn-outline-secondary" type="submit">
								<i class="bi bi-search"></i>
							</button>
						</form>

						<select class="form-select" style="width: 120px;">
							<option>Filter</option>
						</select>
						<a href="{{ path('app_club_new') }}" class="btn btn-primary">
							<i class="bi bi-plus-circle-dotted me-2"></i>
							Add new club
						</a>
					</div>
				</div>
				<div class="card border-0 shadow-sm rounded-3">
					<div class="table-responsive">
						<table class="table align-middle mb-0">
							<thead class="bg-light text-secondary">
								<tr>
									<th>Id</th>
									<th>Name</th>
									<th>Members</th>
									<th>President</th>
									<th>Foundation</th>
									<th>Status</th>
									<th>Image</th>
									<th class="text-center">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for club in clubs %}
									<tr>
										<td class="fw-bold text-muted">#{{ club.id }}</td>
										<td class="fw-semibold">{{ club.name }}</td>
										<td>{{ club.membersCollection|length }}</td>
										<td>{{ club.president }}</td>
										<td>{{ club.foundation ? club.foundation|date('Y-m-d') : '' }}</td>
										<td>
											{% if club.status == 'Active' %}
												<span class="badge rounded-pill text-bg-success bg-opacity-25 text-success">Active</span>
											{% else %}
												<span class="badge rounded-pill text-bg-secondary bg-opacity-25 text-secondary">Inactive</span>
											{% endif %}
										</td>
										<td>
											{% if club.image %}
												<img src="{{ asset('Uploads/' ~ club.image) }}" alt="Club Image" class="img-fluid rounded" style="width: 80px;"/>
											{% else %}
												No image
											{% endif %}
										</td>
										<td class="text-center">
											<a href="{{ path('app_club_show', {'id': club.id}) }}" class="text-decoration-none">
												<i class="bi bi-eye pe-2 text-secondary"></i>
											</a>
											<a href="{{ path('app_club_edit', {'id': club.id}) }}" class="text-decoration-none">
												<i class="bi bi-pen pe-2 text-secondary"></i>
											</a>
											<form method="post" action="{{ path('app_club_delete', {'id': club.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" style="display: inline;">
												<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ club.id) }}">
												<button type="submit" class="btn p-0 border-0 bg-transparent">
													<i class="bi bi-trash pe-2 text-secondary"></i>
												</button>
											</form>
										</td>
									</tr>
								{% else %}
									<tr>
										<td colspan="9" class="text-center py-4">No clubs found.</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
				<div class="d-flex justify-content-between align-items-center mt-4">
					<span class="text-secondary"></span>
					<div class="btn-group">
						<button class="btn btn-outline-secondary btn-sm">Previous</button>
						<button class="btn btn-primary btn-sm">1</button>
						<button class="btn btn-outline-secondary btn-sm">Next</button>
					</div>
					
				</div>
			</main>
		</div>
	</div>
{% endblock %}
