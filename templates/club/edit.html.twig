{% extends 'base.html.twig' %}

{% block title %}Edit Club
{% endblock %}

{% block body %}
	<div class="container-fluid">
		<div class="row">
			{% include "DashNavbar.html.twig" %}
			<main class="col-12 col-md-9 col-lg-10 p-4">
				<div class="d-flex justify-content-between align-items-center mb-4">
					<h1>Edit Club</h1>
				</div>
				<hr>
				{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
				<div class="card p-4 shadow-sm rounded-3">
					<div class="mb-3">
						{{ form_label(form.name) }}
						{{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
						{{ form_errors(form.name) }}
					</div>
					<div class="mb-3">
						{{ form_label(form.description) }}
						{{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
						{{ form_errors(form.description) }}
					</div>
					<div class="mb-3">
						{{ form_label(form.members) }}
						{{ form_widget(form.members, {'attr': {'class': 'form-control'}}) }}
						{{ form_errors(form.members) }}
					</div>
					<div class="mb-3">
						{{ form_label(form.president) }}
						{{ form_widget(form.president, {'attr': {'class': 'form-control'}}) }}
						{{ form_errors(form.president) }}
					</div>
					<div class="mb-3">
						{{ form_label(form.foundation) }}
						{{ form_widget(form.foundation, {'attr': {'class': 'form-control'}}) }}
						{{ form_errors(form.foundation) }}
					</div>
					<div class="mb-3">
						{{ form_label(form.status) }}
						{{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
						{{ form_errors(form.status) }}
					</div>
					<div class="mb-3">
						{{ form_label(form.image) }}
						{{ form_widget(form.image, {'attr': {'class': 'form-control'}}) }}
						{{ form_errors(form.image) }}
					</div>
					<div class="d-flex justify-content-end">
						<a href="{{ path('app_club_index') }}" class="btn btn-outline-secondary me-3">Back to list</a>
						<button class="btn btn-primary">Save Changes</button>
					</div>
				</div>
				{{ form_end(form) }}
			</main>
		</div>
	</div>
{% endblock %}
