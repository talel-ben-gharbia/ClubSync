{% extends 'base.html.twig' %}

{% block title %}Our Clubs{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Custom styling */
    :root {
        --primary-color: #4361ee;
        --secondary-color: #3f37c9;
        --accent-color: #4895ef;
        --light-bg: #f8f9fa;
        --dark-text: #212529;
        --light-text: #6c757d;
    }

    .page-header {
        background-color: var(--light-bg);
        padding: 3rem 0;
        margin-bottom: 3rem;
        position: relative;
        overflow: hidden;
    }

    .page-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(67, 97, 238, 0.05) 0%, rgba(72, 149, 239, 0.1) 100%);
        z-index: 0;
    }

    .page-header .container {
        position: relative;
        z-index: 1;
    }

    .section-title {
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--dark-text);
        position: relative;
        display: inline-block;
    }

    .section-title::after {
        content: '';
        position: absolute;
        width: 50px;
        height: 3px;
        background-color: var(--primary-color);
        bottom: -10px;
        left: 0;
    }

    .section-subtitle {
        color: var(--light-text);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 1.5rem auto;
    }

    .club-card {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
    }

    .club-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .club-image {
        height: 220px;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .club-card:hover .club-image {
        transform: scale(1.05);
    }

    .club-image-container {
        overflow: hidden;
        position: relative;
    }

    .club-image-container::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, rgba(0,0,0,0) 70%, rgba(0,0,0,0.2) 100%);
    }

    .club-card-body {
        padding: 1.5rem;
    }

    .club-title {
        font-weight: 600;
        margin-bottom: 0.75rem;
        color: var(--dark-text);
    }

    .club-description {
        color: var(--light-text);
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
        line-height: 1.6;
    }

    .btn-club-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        border-radius: 6px;
        padding: 0.5rem 1.25rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-club-primary:hover {
        background-color: var(--secondary-color);
        border-color: var(--secondary-color);
        transform: translateY(-2px);
    }

    .btn-club-outline {
        color: var(--primary-color);
        border-color: var(--primary-color);
        border-radius: 6px;
        padding: 0.5rem 1.25rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-club-outline:hover {
        background-color: rgba(67, 97, 238, 0.1);
        color: var(--primary-color);
        transform: translateY(-2px);
    }

    .alert {
        border-radius: 8px;
        border: none;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        background-color: var(--light-bg);
        border-radius: 12px;
    }

    .empty-state-text {
        color: var(--light-text);
        font-size: 1.1rem;
        margin-bottom: 1.5rem;
    }

    @media (max-width: 768px) {
        .page-header {
            padding: 2rem 0;
        }

        .section-title {
            font-size: 1.75rem;
        }

        .section-subtitle {
            font-size: 1rem;
        }
    }
</style>
{% endblock %}

{% block body %}
    {% include "Navbar.html.twig" %}

    <header class="page-header">
        <div class="container text-center">
            <h1 class="section-title text-center mb-4">Our Clubs</h1>
            <p class="section-subtitle">Join our vibrant community of student clubs and organizations to explore your interests, develop new skills, and connect with like-minded peers.</p>
        </div>
    </header>

    <div class="container pb-5">


        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-2 row-cols-xl-3 g-4">
            {% for club in clubs %}
                <div class="col">
                    <div class="card club-card shadow-sm">
                        <div class="club-image-container">
                            <img src="{{ asset('uploads/' ~ club.image) }}" class="club-image" alt="{{ club.name }}">
                        </div>
                        <div class="card-body club-card-body d-flex flex-column">
                            <h5 class="club-title">{{ club.name|capitalize }}</h5>
                            <p class="club-description">{{ club.description|length > 100 ? club.description[:100] ~ '...' : club.description }}</p>
                            <div class="mt-auto d-flex gap-2">
                                {% if app.user %}
                                    <a href="{{ path('app_join_club', { 'id': club.id }) }}" class="btn btn-club-primary w-50">Join Now</a>
                                {% else %}
                                    <a href="{{ path('app_login') }}" class="btn btn-club-primary w-50">Login to Join</a>
                                {% endif %}
                                <a href="{{ path('app_club_show_details', {'id': club.id}) }}" class="btn btn-club-outline w-50">Learn More</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="empty-state">
                        <i class="bi bi-calendar2-x fs-1 text-muted mb-3"></i>
                        <p class="empty-state-text">No clubs available at the moment.</p>
                        <p class="text-muted">Check back soon for new opportunities to join!</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}