{% extends 'base.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block body %}
    {% include "Navbar.html.twig" %}

    <div class="container py-4">
        <div class="row g-4">
            <!-- Sidebar -->
            <div class="col-md-3" data-aos="fade-right">
                <div class="sidebar-nav">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <div class="avatar-circle mx-auto">
                                <i class="bi bi-person-circle" style="font-size: 3rem;"></i>
                            </div>
                        </div>
                        <h5 class="mb-1">{{ app.user.username }}</h5>
                        <p class="text-muted mb-0">{{ app.user.email }}</p>
                    </div>
                    <div class="nav flex-column">
                        <a href="{{ path('app_user_dashboard') }}" class="nav-link">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                        <a href="{{ path('app_user_dashboard_profile') }}" class="nav-link">
                            <i class="bi bi-person"></i> My Profile
                        </a>
                        <a href="{{ path('app_user_dashboard_change_password') }}" class="nav-link active">
                            <i class="bi bi-key"></i> Change Password
                        </a>
                        <a href="{{ path('app_logout') }}" class="nav-link text-danger">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-9">
                <div class="dashboard-card" data-aos="fade-up">
                    <div class="dashboard-card-header">
                        <h1 class="h3 mb-0"><i class="bi bi-key me-2"></i>Change Password</h1>
                    </div>
                </div>

                <!-- Flash Messages -->
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show animate-fade-in">
                            {% if label == 'success' %}<i class="bi bi-check-circle me-2"></i>{% endif %}
                            {% if label == 'danger' %}<i class="bi bi-exclamation-triangle me-2"></i>{% endif %}
                            {% if label == 'warning' %}<i class="bi bi-exclamation-circle me-2"></i>{% endif %}
                            {% if label == 'info' %}<i class="bi bi-info-circle me-2"></i>{% endif %}
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                <!-- Change Password Form -->
                <div class="dashboard-card mt-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="dashboard-card-header">
                        <h2 class="h5 mb-0"><i class="bi bi-shield-lock me-2"></i>Change Your Password</h2>
                    </div>
                    <div class="dashboard-card-body">
                        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                        <div class="mb-3">
                            {{ form_label(form.currentPassword, 'Current Password', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.currentPassword, {'attr': {'class': 'form-control form-control-lg'}}) }}
                            {{ form_errors(form.currentPassword) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.newPassword.first, 'New Password', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control form-control-lg'}}) }}
                            {{ form_errors(form.newPassword.first) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.newPassword.second, 'Confirm New Password', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control form-control-lg'}}) }}
                            {{ form_errors(form.newPassword.second) }}
                        </div>
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-2"></i>Change Password
                            </button>
                        </div>
                        {{ form_end(form) }}

                        <div class="card mt-4 bg-light border-0">
                            <div class="card-body">
                                <h3 class="h6 mb-3"><i class="bi bi-info-circle me-2"></i>Password Guidelines:</h3>
                                <ul class="mb-0 ps-3">
                                    <li class="mb-2">Password must be at least 8 characters long</li>
                                    <li class="mb-2">Include at least one uppercase letter</li>
                                    <li class="mb-2">Include at least one lowercase letter</li>
                                    <li class="mb-2">Include at least one number</li>
                                    <li>Include at least one special character</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Security Tips -->
                <div class="dashboard-card mt-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="dashboard-card-header">
                        <h2 class="h5 mb-0"><i class="bi bi-shield-check me-2"></i>Security Tips</h2>
                    </div>
                    <div class="dashboard-card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <div class="d-flex">
                                    <div class="icon-circle bg-primary bg-opacity-10 me-3 flex-shrink-0">
                                        <i class="bi bi-fingerprint text-primary"></i>
                                    </div>
                                    <div>
                                        <h5 class="h6 mb-2">Use Unique Passwords</h5>
                                        <p class="text-muted small mb-0">Never reuse passwords across different websites or services.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <div class="d-flex">
                                    <div class="icon-circle bg-success bg-opacity-10 me-3 flex-shrink-0">
                                        <i class="bi bi-clock-history text-success"></i>
                                    </div>
                                    <div>
                                        <h5 class="h6 mb-2">Change Regularly</h5>
                                        <p class="text-muted small mb-0">Update your password every 3-6 months for better security.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex">
                                    <div class="icon-circle bg-warning bg-opacity-10 me-3 flex-shrink-0">
                                        <i class="bi bi-shield-lock text-warning"></i>
                                    </div>
                                    <div>
                                        <h5 class="h6 mb-2">Stay Alert</h5>
                                        <p class="text-muted small mb-0">Be cautious of phishing attempts asking for your password.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-white mt-5 py-4 border-top">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-0 text-muted">&copy; {{ "now"|date("Y") }} ClubSync. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a href="#" class="text-muted me-3"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-muted me-3"><i class="bi bi-twitter"></i></a>
                    <a href="#" class="text-muted me-3"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <style>
        .avatar-circle {
            width: 80px;
            height: 80px;
            background-color: var(--light-gray);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            box-shadow: var(--shadow-md);
        }

        .icon-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }
    </style>
{% endblock %}
