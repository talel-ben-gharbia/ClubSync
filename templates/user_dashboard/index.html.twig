{% extends 'base.html.twig' %}

{% block title %}My Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .dashboard-container {
            padding: 20px;
        }
        .dashboard-card {
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
            background-color: white;
            overflow: hidden;
        }
        .dashboard-card-header {
            padding: 15px 20px;
            background-color: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
            font-weight: 600;
        }
        .dashboard-card-body {
            padding: 20px;
        }
        .stat-card {
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            color: white;
            text-align: center;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }
        .stat-card:hover {
            transform: translateY(-5px);
        }
        .stat-card h3 {
            font-size: 1.2rem;
            margin-bottom: 10px;
            font-weight: 600;
        }
        .stat-card p {
            font-size: 2rem;
            font-weight: bold;
            margin: 0;
        }
        .stat-card i {
            font-size: 2rem;
            margin-bottom: 15px;
        }
        .club-card {
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
            transition: transform 0.3s ease;
        }
        .club-card:hover {
            transform: translateY(-5px);
        }
        .club-card-img {
            height: 150px;
            object-fit: cover;
        }
        .club-card-body {
            padding: 15px;
        }
        .club-card-title {
            font-weight: 600;
            margin-bottom: 10px;
        }
        .event-item {
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
            background-color: #f8f9fa;
            transition: transform 0.3s ease;
        }
        .event-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
        .event-title {
            font-weight: 600;
            margin-bottom: 5px;
        }
        .event-date {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 10px;
        }
        .request-item {
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
            background-color: #f8f9fa;
            transition: transform 0.3s ease;
        }
        .request-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
        .request-club {
            font-weight: 600;
            margin-bottom: 5px;
        }
        .request-date {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 10px;
        }
        .nav-pills .nav-link {
            border-radius: 5px;
            padding: 10px 15px;
            margin-right: 5px;
            color: #495057;
        }
        .nav-pills .nav-link.active {
            background-color: #0d6efd;
            color: white;
        }
        .sidebar-nav {
            background-color: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
        }
        .sidebar-nav .nav-link {
            padding: 10px 15px;
            border-radius: 5px;
            margin-bottom: 5px;
            color: #495057;
            transition: all 0.3s ease;
        }
        .sidebar-nav .nav-link:hover {
            background-color: #e9ecef;
        }
        .sidebar-nav .nav-link.active {
            background-color: #0d6efd;
            color: white;
        }
        .sidebar-nav .nav-link i {
            margin-right: 10px;
        }
        @media (max-width: 768px) {
            .sidebar-nav {
                margin-bottom: 20px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% include "Navbar.html.twig" %}

    <div class="container dashboard-container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3">
                <div class="sidebar-nav">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="bi bi-person-circle" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="mb-1">{{ user.username }}</h5>
                        <p class="text-muted mb-0">{{ user.email }}</p>
                    </div>
                    <div class="nav flex-column">
                        <a href="{{ path('app_user_dashboard') }}" class="nav-link active">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                        <a href="{{ path('app_user_dashboard_profile') }}" class="nav-link">
                            <i class="bi bi-person"></i> My Profile
                        </a>
                        <a href="{{ path('app_user_dashboard_change_password') }}" class="nav-link">
                            <i class="bi bi-key"></i> Change Password
                        </a>
                        <a href="{{ path('app_logout') }}" class="nav-link text-danger">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-9">
                <h1 class="mb-4">My Dashboard</h1>

                <!-- Flash Messages -->
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                <!-- Stats Cards -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="stat-card bg-primary">
                            <i class="bi bi-people-fill"></i>
                            <h3>My Clubs</h3>
                            <p>{{ joinedClubs|length }}</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card bg-success">
                            <i class="bi bi-calendar-event"></i>
                            <h3>Upcoming Events</h3>
                            <p>{{ upcomingEvents|length }}</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card bg-info">
                            <i class="bi bi-envelope"></i>
                            <h3>Pending Requests</h3>
                            <p>{{ pendingRequests|length }}</p>
                        </div>
                    </div>
                </div>

                <!-- My Clubs Section -->
                <div class="dashboard-card">
                    <div class="dashboard-card-header d-flex justify-content-between align-items-center">
                        <h2 class="h5 mb-0">My Clubs</h2>
                        <a href="{{ path('app_club_show2') }}" class="btn btn-sm btn-outline-primary">Browse Clubs</a>
                    </div>
                    <div class="dashboard-card-body">
                        {% if joinedClubs|length > 0 %}
                            <div class="row">
                                {% for club in joinedClubs %}
                                    {% if club %}
                                        <div class="col-md-6">
                                            <div class="club-card">
                                                <img src="{{ asset('uploads/' ~ club.image) }}" class="club-card-img w-100" alt="{{ club.name }}">
                                                <div class="club-card-body">
                                                    <h3 class="club-card-title h5">{{ club.name }}</h3>
                                                    <p class="text-muted">{{ club.description|length > 100 ? club.description|slice(0, 100) ~ '...' : club.description }}</p>
                                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                                        <a href="{{ path('app_club_show_details', {'id': club.id}) }}" class="btn btn-sm btn-outline-primary">View Details</a>
                                                        {% if attribute(user, 'clubRole') is defined and user.clubRole != 'manager' %}
                                                            <a href="{{ path('app_user_dashboard_leave_club', {'id': club.id}) }}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to leave this club?')">Leave Club</a>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="text-center py-4">
                                <i class="bi bi-people" style="font-size: 3rem; color: #dee2e6;"></i>
                                <p class="mt-3 text-muted">You haven't joined any clubs yet.</p>
                                <a href="{{ path('app_club_show2') }}" class="btn btn-primary">Browse Clubs</a>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- My Events Section -->
                <div class="dashboard-card mt-4">
                    <div class="dashboard-card-header">
                        <h2 class="h5 mb-0">My Events</h2>
                    </div>
                    <div class="dashboard-card-body">
                        <ul class="nav nav-pills mb-3" id="events-tab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="upcoming-events-tab" data-bs-toggle="pill" data-bs-target="#upcoming-events" type="button" role="tab" aria-controls="upcoming-events" aria-selected="true">Upcoming Events</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="past-events-tab" data-bs-toggle="pill" data-bs-target="#past-events" type="button" role="tab" aria-controls="past-events" aria-selected="false">Past Events</button>
                            </li>
                        </ul>
                        <div class="tab-content" id="events-tabContent">
                            <div class="tab-pane fade show active" id="upcoming-events" role="tabpanel" aria-labelledby="upcoming-events-tab">
                                {% if upcomingEvents|length > 0 %}
                                    {% for event in upcomingEvents %}
                                        <div class="event-item">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h3 class="event-title h6">{{ event.name }}</h3>
                                                    <div class="event-date">
                                                        <i class="bi bi-calendar-event me-1"></i>
                                                        {{ event.startDate|date('F d, Y') }}
                                                        {% if event.startTime %}
                                                            at {{ event.startTime|date('g:i A') }}
                                                        {% endif %}
                                                    </div>
                                                    <div class="text-muted mb-2">
                                                        <i class="bi bi-geo-alt me-1"></i>
                                                        {{ event.location }}
                                                    </div>
                                                    <div>
                                                        <span class="badge bg-primary">{{ event.status }}</span>
                                                        <span class="badge bg-secondary">{{ event.club.name }}</span>
                                                    </div>
                                                </div>
                                                <a href="{{ path('app_event_show_public', {'id': event.id}) }}" class="btn btn-sm btn-outline-primary">View Details</a>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="text-center py-4">
                                        <i class="bi bi-calendar-x" style="font-size: 3rem; color: #dee2e6;"></i>
                                        <p class="mt-3 text-muted">You don't have any upcoming events.</p>
                                        <a href="{{ path('app_event_list_public') }}" class="btn btn-primary">Browse Events</a>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="tab-pane fade" id="past-events" role="tabpanel" aria-labelledby="past-events-tab">
                                {% if pastEvents|length > 0 %}
                                    {% for event in pastEvents %}
                                        <div class="event-item">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h3 class="event-title h6">{{ event.name }}</h3>
                                                    <div class="event-date">
                                                        <i class="bi bi-calendar-event me-1"></i>
                                                        {{ event.startDate|date('F d, Y') }}
                                                        {% if event.startTime %}
                                                            at {{ event.startTime|date('g:i A') }}
                                                        {% endif %}
                                                    </div>
                                                    <div class="text-muted mb-2">
                                                        <i class="bi bi-geo-alt me-1"></i>
                                                        {{ event.location }}
                                                    </div>
                                                    <div>
                                                        <span class="badge bg-secondary">{{ event.status }}</span>
                                                        <span class="badge bg-secondary">{{ event.club.name }}</span>
                                                    </div>
                                                </div>
                                                <a href="{{ path('app_event_show_public', {'id': event.id}) }}" class="btn btn-sm btn-outline-primary">View Details</a>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="text-center py-4">
                                        <i class="bi bi-calendar-x" style="font-size: 3rem; color: #dee2e6;"></i>
                                        <p class="mt-3 text-muted">You don't have any past events.</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Join Requests Section -->
                <div class="dashboard-card mt-4">
                    <div class="dashboard-card-header">
                        <h2 class="h5 mb-0">My Join Requests</h2>
                    </div>
                    <div class="dashboard-card-body">
                        {% if pendingRequests|length > 0 %}
                            {% for request in pendingRequests %}
                                <div class="request-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h3 class="request-club h6">{{ request.club is defined ? request.club.name : request.club_name }}</h3>
                                            <div class="request-date">
                                                <i class="bi bi-clock me-1"></i>
                                                Submitted on {{ request.created_at|date('F d, Y') }}
                                            </div>
                                            <div>
                                                <span class="badge bg-warning">{{ request.status|capitalize }}</span>
                                                <span class="badge bg-secondary">{{ request.department }}</span>
                                                <span class="badge bg-secondary">{{ request.class }}</span>
                                            </div>
                                        </div>
                                        <a href="{{ path('app_user_dashboard_cancel_request', {'clubId': attribute(request, 'club') is defined ? request.club.id : request.club_id}) }}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this request?')">Cancel Request</a>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-4">
                                <i class="bi bi-envelope-x" style="font-size: 3rem; color: #dee2e6;"></i>
                                <p class="mt-3 text-muted">You don't have any pending join requests.</p>
                                <a href="{{ path('app_club_show2') }}" class="btn btn-primary">Browse Clubs</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
